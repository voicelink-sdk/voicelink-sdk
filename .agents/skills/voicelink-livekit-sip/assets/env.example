# Copy to .env next to the scripts. All scripts read it; real environment variables win.

# VoiceLink
# UAT: https://voicelinkuat.elisiontec.com/api   production: https://app.voicelink.co.in/api
VOICELINK_BASE_URL=https://voicelinkuat.elisiontec.com/api
VOICELINK_USER=your-username
VOICELINK_PASS=your-password
# VOICELINK_TOKEN=            # alternative to user/pass; wins if set
VOICELINK_CLIENT_ID=123       # required for reseller accounts: the client that owns the DID
VOICELINK_DID=91XXXXXXXXXX    # digits only, with country code

# SIP bridge (Asterisk) - your host, not LiveKit
VOICELINK_BRIDGE_HOST=203.0.113.10   # public IPv4 (not a hostname) - becomes the LiveKit allowlist <ip>/32
VOICELINK_BRIDGE_PORT=35060          # the port the bridge listens on; 5060 is often ISP-blocked
VOICELINK_TRUNK_USERNAME=    # fixed trunk digest credentials the bridge's outbound auth uses;
VOICELINK_TRUNK_PASSWORD=    # leave both blank to let VoiceLink generate them per trunk

# LiveKit (project settings -> keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-key
LIVEKIT_API_SECRET=your-secret
LIVEKIT_SIP_URI=your-project-id.sip.livekit.cloud   # the bridge forwards inbound calls here
LIVEKIT_AGENT_NAME=voice-assistant

# Agent speech and language services (livekit_agent.py)
STT_PROVIDER=deepgram      # deepgram | sarvam | openai
LLM_PROVIDER=openai        # openai | groq
TTS_PROVIDER=openai        # openai | sarvam | deepgram
DEEPGRAM_API_KEY=your-key
OPENAI_API_KEY=your-key
# GROQ_API_KEY=
# SARVAM_API_KEY=
# LLM_MODEL=               # e.g. gpt-4o-mini (openai) or openai/gpt-oss-20b (groq)
# STT_MODEL= / TTS_MODEL= / TTS_VOICE= / STT_LANGUAGE= / TTS_LANGUAGE=

# Outbound test only (provision_outbound.py --call; spends balance)
CALL_TO=9XXXXXXXXX         # national number
CALL_COUNTRY_CODE=91
