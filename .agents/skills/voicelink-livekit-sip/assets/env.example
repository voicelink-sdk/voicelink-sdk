# VoiceLink
VOICELINK_BASE_URL=https://voicelinkuat.elisiontec.com/api
VOICELINK_USER=your-username
VOICELINK_PASS=your-password
# VOICELINK_TOKEN=            # alternative to user/pass
VOICELINK_CLIENT_ID=123       # required for reseller accounts
VOICELINK_DID=919876543210

# SIP bridge (Asterisk) — your host, not LiveKit
VOICELINK_BRIDGE_HOST=sip-bridge.example.com
VOICELINK_BRIDGE_PORT=5060    # use a high port (e.g. 35060) if your ISP blocks 5060

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-key
LIVEKIT_API_SECRET=your-secret
LIVEKIT_SIP_URI=your-project-id.sip.livekit.cloud
LIVEKIT_AGENT_NAME=voice-assistant

# Agent models
DEEPGRAM_API_KEY=your-key
OPENAI_API_KEY=your-key

# Outbound test only (spends balance)
CALL_TO=91XXXXXXXXXX
