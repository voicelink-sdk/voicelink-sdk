# VoiceLink
# UAT: https://voicelinkuat.elisiontec.com/api   production: https://app.voicelink.co.in/api
VOICELINK_BASE_URL=https://voicelinkuat.elisiontec.com/api
VOICELINK_USER=your-username
VOICELINK_PASS=your-password
# VOICELINK_TOKEN=            # alternative to user/pass; wins if set
VOICELINK_CLIENT_ID=123       # required for reseller accounts
VOICELINK_DID=91XXXXXXXXXX    # digits only, with country code, no "+"

# Your Pipecat bot server (pipecat_bot.py listens on PORT, default 8080)
PORT=8080
VOICELINK_BOT_NAME=pipecat-agent
VOICELINK_WS_URL=wss://your-tunnel.ngrok-free.dev   # public wss:// host, NO path
VOICELINK_WEBHOOK_URL=                              # optional https:// call-event endpoint

# Speech and language services - any Pipecat provider, chosen by name.
# Each named provider needs <PROVIDER>_API_KEY. `echo` needs none of these,
# `repeat` needs STT + TTS, `bot` also needs an LLM.
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
LLM_PROVIDER=
SARVAM_API_KEY=your-key
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# Leave models blank for the provider default. Sarvam STT on Pipecat 1.12+ accepts only
# saaras:v3 or saaras:v4 - older saarika:* names stop the server at startup.
STT_MODEL=
TTS_MODEL=
TTS_VOICE=
STT_LANGUAGE=en-IN
TTS_LANGUAGE=en-IN

# Outbound test only (spends balance)
CALL_TO=9XXXXXXXXX            # NATIONAL number, no country code
CALL_COUNTRY_CODE=91

# Debugging only: outbound audio carries both stream_sid and streamSid.
# Set to 0 to send snake_case only.
# VOICELINK_SID_ALIAS=1
