# ============================================================================
#  VoiceLink SDK — example configuration
#
#  Copy this file to `.env` in the repo root and replace the values.
#      Windows:  copy env.example .env
#      Linux/Mac: cp env.example .env
#
#  `examples/pipecat_quickstart.py` reads `.env` automatically.
#  `examples/livekit_quickstart.py` does NOT — load the values into your shell
#  first (see the note at the bottom of this file).
#
#  Never commit your filled-in `.env` — it holds passwords and API keys.
# ============================================================================


# ---------------------------------------------------------------------------
#  1. VoiceLink account            REQUIRED for both integrations
# ---------------------------------------------------------------------------

# Log in with your portal username and password...
VOICELINK_USER=yourname@yourcompany.com
VOICELINK_PASS=your-portal-password

# ...or skip the two lines above and use a long-lived API token instead.
# If VOICELINK_TOKEN is set, USER/PASS are ignored.
# VOICELINK_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...

# Which customer these bots and numbers belong to.
# Reseller accounts MUST set this. A direct client can leave it blank.
VOICELINK_CLIENT_ID=560

# Which VoiceLink server to talk to.
#   UAT / testing : https://voicelinkuat.elisiontec.com/api      <- default
#   production    : https://app.voicelink.co.in/api
VOICELINK_BASE_URL=https://voicelinkuat.elisiontec.com/api

# The phone number callers dial. Digits only — country code, no "+", no spaces.
VOICELINK_DID=919484950416


# ---------------------------------------------------------------------------
#  2. Pipecat                      examples/pipecat_quickstart.py
# ---------------------------------------------------------------------------

# Any name you like. The SDK creates a bot with this name, or updates the
# existing one if the name already exists — so re-running is safe.
VOICELINK_BOT_NAME=my-agent

# The public address of YOUR bot server. VoiceLink opens a WebSocket to it and
# streams the call audio. Must be reachable from the internet and use wss://.
#   production : wss://bot.yourcompany.com/ws
#   testing    : an ngrok URL, e.g. wss://abc-def-ghi.ngrok-free.dev
VOICELINK_WS_URL=wss://bot.yourcompany.com/ws

# Optional. VoiceLink POSTs call events here (initiated / ringing / answered /
# ended). Leave blank if you don't need them.
VOICELINK_WEBHOOK_URL=


# ---------------------------------------------------------------------------
#  3. AI services                  only needed to RUN a bot, not to configure one
#
#  `show`, `inbound`, `outbound` and `restore` work without any of these.
#  `echo`   needs nothing at all.
#  `repeat` needs speech-to-text and text-to-speech.
#  `bot`    needs those plus a language model.
#
#  NO PROVIDER IS BUILT IN. You name one, the SDK loads it. Any provider that
#  Pipecat supports works — deepgram, sarvam, azure, elevenlabs, cartesia,
#  google, groq, openai, anthropic, rime, and about thirty more. Switching is a
#  line in this file, never a code change.
#
#  Install the one you choose:
#      pip install "pipecat-ai[sarvam]"        # or deepgram, elevenlabs, ...
# ---------------------------------------------------------------------------

# Which provider handles each job. They can differ - recognition from one
# vendor, the voice from another.
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# Only for `bot` mode. Leave blank and `repeat` still works with no LLM at all.
LLM_PROVIDER=

# One key per provider you named above, as <PROVIDER>_API_KEY.
# Only the ones you actually use need a value.
SARVAM_API_KEY=sk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPGRAM_API_KEY=0000000000000000000000000000000000000000
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave any of these blank to take the provider's own default.
#   Sarvam   : saarika:v2.5 / bulbul:v3, voices priya, aditya, neha, rahul...
#   Deepgram : nova-3-general / aura-2-helena-en
STT_MODEL=saarika:v2.5
TTS_MODEL=bulbul:v3
TTS_VOICE=priya

# Optional. Helps recognition a lot on Indian-accented English.
STT_LANGUAGE=en-IN
TTS_LANGUAGE=en-IN


# ---------------------------------------------------------------------------
#  4. Outbound test call           used by BOTH quickstarts
# ---------------------------------------------------------------------------

# The number to dial. NATIONAL number only — do NOT include the country code
# here, it goes in the line below.
#   correct   : 9876543210   + CALL_COUNTRY_CODE=91
#   wrong     : 919876543210 with no country code
#               -> the call fails with "38 - Network out of order"
CALL_TO=9876543210

# The country code on its own, digits only.
CALL_COUNTRY_CODE=91


# ---------------------------------------------------------------------------
#  5. LiveKit                      examples/livekit_quickstart.py
# ---------------------------------------------------------------------------

# From your LiveKit Cloud project settings.
LIVEKIT_URL=wss://yourproject.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The name your LiveKit agent worker registers under. LiveKit uses this to
# decide which agent joins the call.
LIVEKIT_AGENT_NAME=voice-assistant

# Your SIP bridge — the Asterisk (or similar) machine you run.
# VoiceLink speaks plain SIP; LiveKit Cloud only accepts TLS SIP. The bridge
# sits between them and translates, so both trunks point HERE, never at each
# other.
VOICELINK_BRIDGE_HOST=203.0.113.10

# The SIP port your bridge listens on. The script falls back to 5060 if this is
# unset, which is usually NOT what you want — set it explicitly.
VOICELINK_BRIDGE_PORT=35060

# Informational only — the current scripts do not read this. Kept because you
# would need it if you ever point VoiceLink straight at LiveKit over TLS SIP,
# instead of through the bridge.
# LIVEKIT_SIP_URI=abc123.sip.livekit.cloud


# ---------------------------------------------------------------------------
#  6. Debugging                    leave these alone unless asked
# ---------------------------------------------------------------------------

# Outbound media messages carry both `stream_sid` and `streamSid`, because
# VoiceLink is inconsistent about casing. Set to 0 to send snake_case only.
# VOICELINK_SID_ALIAS=1


# ---------------------------------------------------------------------------
#  Running the LiveKit quickstart
#
#  It reads real environment variables, not this file. Load them first:
#
#    Windows PowerShell
#      Get-Content .env | ForEach-Object {
#        if ($_ -match '^(\w+)=(.*)$') {
#          [Environment]::SetEnvironmentVariable($matches[1], $matches[2])
#        }
#      }
#
#    Linux / Mac
#      export $(grep -v '^#' .env | xargs)
# ---------------------------------------------------------------------------
